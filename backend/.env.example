# ============================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================

# Application
APP_NAME=Enterprise BMS
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Email (fill when needed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Lekuka Integration (fill in Phase 2)
LEKUKA_BASE_URL=
LEKUKA_DEVICE_CERT_PATH=
LEKUKA_DEVICE_KEY_PATH=
LEKUKA_CA_CERT_PATH=

# Email (Brevo transactional email)
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@mrservices.co.ls
EMAIL_FROM_NAME=MalutiRecon
INVITATION_EXPIRES_HOURS=24
